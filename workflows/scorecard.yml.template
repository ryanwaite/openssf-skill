# OpenSSF Scorecard Workflow
# This workflow runs OpenSSF Scorecard to assess your project's security posture.
# Results are published to the Security tab and can be viewed at https://scorecard.dev

name: OpenSSF Scorecard

on:
  # Run on pushes to main branch
  push:
    branches: [main, master]

  # Run weekly to catch changes in dependencies and security practices
  schedule:
    - cron: '0 6 * * 1'  # Every Monday at 6 AM UTC

  # Manual runs are experimental upstream; publish only on push/schedule.
  workflow_dispatch:

# Declare default permissions as read only
permissions: read-all

jobs:
  analysis:
    name: Scorecard Analysis
    runs-on: ubuntu-latest

    permissions:
      # Required for uploading SARIF results
      security-events: write
      # Required only when publish_results is true
      id-token: write
      # Required for reading repo contents
      contents: read
      # Required for accessing workflow artifacts
      actions: read

    steps:
      - name: Checkout code
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false

      - name: Run Scorecard
        uses: ossf/scorecard-action@fa7117db83c52d787ae5a89f350999701505d78e # v2.5.0 (GHCR)
        with:
          results_file: results.sarif
          results_format: sarif
          # Public results/badge; disable for private repos or if publishing is undesired.
          publish_results: ${{ github.event_name != 'workflow_dispatch' }}

      - name: Upload SARIF results to Security tab
        uses: github/codeql-action/upload-sarif@9418214df1f2c4b8128c770156c409013b07d6b9 # v3.39.3
        with:
          sarif_file: results.sarif

      # Optional: Upload results as artifact for debugging
      - name: Upload Scorecard results
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: scorecard-results
          path: results.sarif
          retention-days: 5
