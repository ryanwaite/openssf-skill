# Copy this file to .gitlab-ci.yml, or merge individual jobs into your existing
# pipeline (and add "release" to its stages when enabling release SBOMs).
# Default: one blocking history scan; no project registry, SBOM, or other scanner.
# Optional jobs are gated by CI/CD variables, not by an implicit tool battery.
# Requires a Docker executor able to pull the named images (GHCR by default).
stages:
  - test
  - release

gitleaks:
  stage: test
  image:
    name: ghcr.io/gitleaks/gitleaks:v8.30.1
    entrypoint: [""]
  variables:
    GIT_DEPTH: "0"
  script:
    # Do not use --verbose or upload the raw findings as an artifact.
    - gitleaks git --redact .
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'

# Optional: enable ENABLE_OSV_SCAN=true in CI/CD variables to scan dependencies.
# OSV v2's Go call analysis is enabled by default; disable it for untrusted MRs.
# A finding and an execution error both fail this job; investigate the job log.
osv-scanner:
  stage: test
  image:
    name: ghcr.io/google/osv-scanner:v2.7.1
    entrypoint: [""]
  script:
    - osv-scanner scan source --no-call-analysis=go --recursive .
  rules:
    - if: '$ENABLE_OSV_SCAN == "true" && $CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$ENABLE_OSV_SCAN == "true" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'

# Optional: enable ENABLE_RELEASE_SBOM=true before creating a release tag.
# This inventories source, not a built image. The binary checksum is for
# syft v1.57.1's linux/amd64 release; use an amd64 runner for this job.
sbom-generation:
  stage: test
  image: alpine:3.22
  script:
    - apk add --no-cache ca-certificates
    - wget -q https://github.com/anchore/syft/releases/download/v1.57.1/syft_1.57.1_linux_amd64.tar.gz -O syft.tar.gz
    - echo "bf52519eb57f675d47c07d43213cb6dff6449f3d6d1147ff6701ed91f44eef0c  syft.tar.gz" | sha256sum -c -
    - tar -xzf syft.tar.gz -C /tmp syft
    - rm syft.tar.gz
    - /tmp/syft dir:. -o spdx-json=sbom.spdx.json
    - printf 'SBOM_JOB_ID=%s\n' "$CI_JOB_ID" > sbom.env
  artifacts:
    paths:
      - sbom.spdx.json
    reports:
      dotenv: sbom.env
    expire_in: 1 year
  rules:
    - if: '$ENABLE_RELEASE_SBOM == "true" && $CI_COMMIT_TAG'

# The release links to the SBOM *producer* job, not this release job.
# Job artifacts expire after one year (or may be deleted sooner by an admin);
# for permanent release assets, publish a copy to durable storage instead.
release-sbom:
  stage: release
  image: registry.gitlab.com/gitlab-org/cli:v1.126.0
  variables:
    GLAB_ENABLE_CI_AUTOLOGIN: "true"
  needs:
    - job: sbom-generation
      artifacts: true
  script:
    - test -n "$SBOM_JOB_ID" && test -s sbom.spdx.json
    - |
      glab release create "$CI_COMMIT_TAG" \
        --name "Release $CI_COMMIT_TAG" \
        --notes "Source SBOM for $CI_COMMIT_TAG (artifact retained for one year)." \
        --assets-links "[{\"name\":\"Source SBOM (SPDX)\",\"url\":\"${CI_PROJECT_URL}/-/jobs/${SBOM_JOB_ID}/artifacts/file/sbom.spdx.json\",\"link_type\":\"other\"}]"
  rules:
    - if: '$ENABLE_RELEASE_SBOM == "true" && $CI_COMMIT_TAG'
