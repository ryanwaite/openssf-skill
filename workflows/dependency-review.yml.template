# Dependency Review Workflow
# This workflow checks for vulnerable or unwanted dependencies in pull requests.
# Start with this PR check; OSV scanning is an independent, optional follow-on.
# Requires the dependency graph/API (public repos or private repos with GHAS).
# Dependency Review v5 needs Actions Runner 2.327.1+ on self-hosted runners.

name: Dependency Review

on:
  pull_request:
    branches: [main, master]

permissions:
  contents: read

jobs:
  dependency-review:
    name: Review Dependencies
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2

      - name: Dependency Review
        uses: actions/dependency-review-action@a1d282b36b6f3519aa1f3fc636f609c47dddb294 # v5.0.0
        with:
          # Fail on vulnerabilities with these severities
          fail-on-severity: moderate

          # Optional: license allowlist (deny-licenses is deprecated in v5).
          # allow-licenses: MIT, Apache-2.0, BSD-3-Clause

          # Optional: also gate development-scope vulnerabilities.
          # fail-on-scopes: runtime, development

          # Optional: document any advisory exception before adding it.
          # allow-ghsas: GHSA-xxxx-xxxx-xxxx


  # Optional OSV PR diff scan: uncomment only this job when you want it.
  # Requires access to google/osv-scanner-action and a runner with its toolchain.
  # osv-pr:
  #   permissions:
  #     actions: read
  #     contents: read
  #     security-events: write
  #   uses: google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@b1d267aea5211fa648d9d442fa64b90dbdcbdd36 # v2.7.0
  #   with:
  #     fail-on-vuln: true
  #     upload-sarif: ${{ github.event.pull_request.head.repo.full_name == github.repository }}
  #     scan-args: |-
  #       --no-call-analysis=go
  #       --recursive
  #       ./
  # Fork PRs may lack security-events:write; this skips their SARIF upload.
